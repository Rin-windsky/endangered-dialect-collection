# 会话 JWT 签名密钥（至少 32 个字符，生产环境请使用随机强密钥）
JWT_SECRET=replace-with-a-random-secret-key-at-least-32-chars

# 站点访问地址（用于同源校验及生成文件存储 URL）
SITE_URL=http://localhost:3000

# 预置审核员用户名（可选，与密码同时配置时在内存初始化阶段自动创建）
SEED_REVIEWER_USERNAME=reviewer_demo

# 预置审核员密码（可选，长度 8-72 位，与用户名同时配置时生效）
SEED_REVIEWER_PASSWORD=reviewer_pass_123
